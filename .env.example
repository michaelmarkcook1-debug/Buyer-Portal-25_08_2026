# ── Database (facts: vendor universe, contract spine, landed AG signals, SEC) ──
# The canonical Neon spine is the estate's sanctioned request-time read surface.
# Canonical tables are only ever read. The portal writes only its own tables
# (portal_user, portal_refresh_run, portal_llm_spend), created on first use.
# Fastest setup — copy the sibling repo's env file:
#   cp "../AG Sourcing Tool 20_06_2026/.env" .env.local
DATABASE_URL=""

# ── Analyst Insight (LLM) ─────────────────────────────────────────────────────
# ANTHROPIC_API_KEY is the primary path. The Vercel AI Gateway is supported only
# with an EXPLICIT base URL (its Anthropic-compatible endpoint, from your
# gateway settings) — no endpoint is guessed. With nothing set, every Analyst
# Insight renders its not-configured state; the portal never substitutes prose.
ANTHROPIC_API_KEY=""
AI_GATEWAY_API_KEY=""
AI_GATEWAY_BASE_URL=""
# Optional override; defaults to claude-sonnet-5.
INSIGHT_MODEL=""
# Ceiling on model calls per hour across all instances (default 150; 0 = none).
# Past it, briefings read as briefly unavailable; figures are unaffected.
INSIGHT_HOURLY_CALL_CAP=

# ── AG decision-brief service (interpretation; not wired to any page yet) ────
# The SourcingGenius /api/decision endpoint — consumed, never reimplemented.
# The adapter (lib/adapters/decision-api.ts) exists for when a surface uses it.
DECISION_API_URL=""     # e.g. https://<sourcing-genius-deployment>/api/decision
DECISION_API_TOKEN=""

# ── Sign-in ───────────────────────────────────────────────────────────────────
# AUTH_SECRET signs session cookies (32+ characters; shorter = sign-in off).
AUTH_SECRET=""
# The code carried by the general sign-up link (12+ characters; unset = closed).
PILOT_SIGNUP_CODE=""
# Comma-separated admin addresses. An admin account is created only with
#   pnpm admin:create someone@yourcompany.com
# never through the sign-up link.
ADMIN_EMAILS=""
# The guest link code (/guest?code=...; 12+ characters; unset = off).
GUEST_ACCESS_CODE=""
# "on" opens the buyer pages to everyone as a guest. The Backoffice and its
# refresh endpoint still require a signed-in admin.
PUBLIC_ACCESS=""

# ── Backoffice refresh ────────────────────────────────────────────────────────
# Local checkout of the AG repo the refresh runs from (development only; a
# deployed portal dispatches the AG GitHub Actions workflow instead).
BACKOFFICE_REFRESH_DIR=""

# ── Diagnostics ───────────────────────────────────────────────────────────────
# Log any query slower than this many milliseconds (unset = off).
DB_SLOW_MS=""
